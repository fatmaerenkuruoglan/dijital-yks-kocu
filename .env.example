# Bu dosyayi .env adiyla kopyalayip yerel ayarlarinizi doldurun.
# Gercek .env dosyasini GitHub'a yuklemeyin.
PORT=3000
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=your_database_name
DB_USER=your_database_user
DB_PASSWORD=
DB_ENCRYPT=true
# Yalnizca yerel, kendinden imzali sertifikali gelistirme ortaminda gerekirse true yapin.
DB_TRUST_SERVER_CERTIFICATE=false
JWT_SECRET=
